# --- Database: Supabase Postgres (Production) ---
# Supabase Dashboard -> Project Settings -> Database -> Connect:
# 1) Transaction pooler (port 6543, append ?pgbouncer=true&connection_limit=15&pool_timeout=30&connect_timeout=30) -> DATABASE_URL
# 2) Direct connection or Session pooler (port 5432, used by prisma migrate deploy) -> DIRECT_URL
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30&connect_timeout=30"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Gemma 4 via Gemini API (server only, never NEXT_PUBLIC) ---
GEMINI_API_KEY=
GEMMA_PRIMARY=gemma-4-31b-it
GEMMA_FALLBACK=gemma-4-26b-a4b-it

# --- GitHub read-only ---
GITHUB_TOKEN=
# Hosted demo stays allowlisted; use * for testing with any public repo
ALLOWLIST_REPOS=patchsignal/demo-signup

# --- Runner (Docker host) ---
RUNNER_TOKEN=
RUNNER_URL=http://localhost:5001
CONTROL_SHA=

# --- Cloudinary (server only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=patchsignal

# --- Auth (HS256 JWT, 7d expiry; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
JWT_SECRET=

# --- Model provider: gemini (default, prize path) or groq (presentation reliability) ---
MODEL_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=

# --- CORS: browser origins allowed to call /api (comma-separated, or * for dev) ---
CORS_ORIGINS=*
